<?xml version="1.0" encoding="utf-8"?>
<!--
    PROJECTE BASE 1C — pantalla principal: la llista de contactes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arrel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitol"
        style="@style/TextTitol"
        android:layout_marginBottom="12dp"
        android:text="@string/titol_principal" />

    <EditText
        android:id="@+id/etCerca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="name"
        android:hint="@string/cerca_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btnActualitza"
        style="@style/BotoContactes.Boto.Primary"
        android:layout_marginTop="8dp"
        android:text="@string/btn_actualitza" />

    <ProgressBar
        android:id="@+id/pbCarga"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtAvis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/avis_background"
        android:padding="8dp"
        android:textColor="@color/avis_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtBuit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/txt_buit"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContactes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
