<?xml version="1.0" encoding="utf-8"?>
<!--
    PROJECTE BASE 1C — tema de l'aplicació (tema clar) i estils reutilitzables.

    Theme.Contactes .............. tema de l'aplicació (DayNight: clar i fosc)
    BotoContactes.Boto .......... base dels botons
    BotoContactes.Boto.Primary ... botó principal (Actualitza)
    BotoContactes.Boto.Container . botó secundari (accions del detall)
    TextTitol .................... títol de secció
    TextMonograma ................ text de les inicials dins del cercle

    El tema nocturn es defineix a res/values-night/themes.xml.
-->
<resources>

    <style name="Theme.Contactes" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="BotoContactes.Boto" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotoContactes.Boto.Primary" parent="BotoContactes.Boto">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="BotoContactes.Boto.Container" parent="BotoContactes.Boto">
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary_container</item>
    </style>

    <style name="TextTitol">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextMonograma">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/monograma_text</item>
        <item name="android:background">@drawable/bg_monograma</item>
    </style>

    <style name="TextCamp" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextCampEtiqueta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
