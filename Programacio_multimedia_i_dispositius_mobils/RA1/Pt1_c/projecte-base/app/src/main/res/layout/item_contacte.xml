<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/background"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvInicials"
        style="@style/TextMonograma"
        android:background="@drawable/bg_monograma"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        tools:text="MF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextCamp"
            android:textColor="@color/text_primary"
            tools:text="Marta Ferrer" />

        <TextView
            android:id="@+id/tvCiutat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/TextCamp"
            android:textColor="@color/text_secondary"
            tools:text="Barcelona" />

        <TextView
            android:id="@+id/tvCorreu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/TextCamp"
            android:textColor="@color/text_secondary"
            tools:text="marta.ferrer@example.cat" />

    </LinearLayout>

    <CheckBox
        android:id="@+id/chkFavorit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>