<?xml version="1.0" encoding="utf-8"?>
<!--
    PROJECTE BASE — layout provisional del menú principal.

    Cal substituir-lo per la versió definitiva:
    títol de l'app + tres botons (temperatura, longitud i massa)
    amb els identificadors indicats a l'enunciat.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/textTitol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitle"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/BotoTemperatura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boto_temperatura"
        android:theme="@style/BotoConversor.Boto.Container"/>


    <Button
        android:id="@+id/BotoLongitud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boto_longitud"
        android:theme="@style/BotoConversor.Boto.Container"/>


    <Button
        android:id="@+id/BotoMassa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boto_massa"
        android:theme="@style/BotoConversor.Boto.Container"/>


</LinearLayout>
