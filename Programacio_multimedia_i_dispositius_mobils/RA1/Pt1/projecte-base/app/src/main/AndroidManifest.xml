<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conversor">

        <!--
            PROJECTE BASE: només hi ha declarada la pantalla d'inici.

            Has de declarar aquí les tres Activities del conversor
            (TemperaturaActivity, LongitudActivity i MassaActivity),
            amb android:exported="false" i l'etiqueta (@string/..._titol)
            que les toca com a títol de la pantalla.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TemperaturaActivity"
            android:exported="false"
            android:label="@string/temperatura_titol">
        </activity>

        <activity
            android:name=".LongitudActivity"
            android:exported="false"
            android:label="@string/longitud_titol">
        </activity>

        <activity
            android:name=".MassaActivity"
            android:exported="false"
            android:label="@string/massa_titol">
        </activity>

    </application>

</manifest>
